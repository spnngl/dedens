d8	SVCB	16 foo.example.org. ( alpn=h2,h3-19 mandatory=ipv4hint,alpn ipv4hint=192.0.2.1 )
d9	SVCB	16 foo.example.org. alpn="f\\\\oo\\,bar,h2"
d10	SVCB	16 foo.example.org. alpn=f\\\092oo\092,bar,h2

