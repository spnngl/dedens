# dedensd as a system service (D156): unprivileged from the start, with only the capability to bind port 53.
# Not enabled by the package: systemctl enable --now dedensd
[Unit]
Description=dédéns DNS server
Documentation=https://github.com/spnngl/dedens
Wants=network-online.target nss-lookup.target
After=network-online.target
Before=nss-lookup.target

[Service]
# `exec`: a binary that cannot run fails the start; dedensd does not notify readiness.
Type=exec
ExecStart=/usr/sbin/dedensd --config /etc/dedensd/dedensd.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
User=dedensd
Group=dedensd
# /var/cache/dedensd, the `downloads.dir` of the packaged configuration.
CacheDirectory=dedensd
# systemd's soft default, 1024, is short of a server's sockets.
LimitNOFILE=524288
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A refused call fails with EPERM instead of killing: a refused io_uring falls back to poll.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
