{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    // The shared preset at HEAD of main.
    "extends": ["github>spnngl/.github:renovate.default.json5"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Versions in the justfile, annotated with a `# renovate:` comment on the line above.",
            "managerFilePatterns": ["/(^|/)justfile$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n[a-z_]+ := \"(?<currentValue>[^\"]+)\"",
            ],
            "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}",
        },
        {
            "customType": "regex",
            "description": "Images in the justfile, pinned by tag and digest.",
            "managerFilePatterns": ["/(^|/)justfile$/"],
            "matchStrings": ["\"(?<depName>docker\\.io/[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""],
            "datasourceTemplate": "docker",
        },
    ],
    "packageRules": [
        {
            "description": "The pinned stable (rust-toolchain.toml, Renovate's own manager) and the Containerfile's `rust:<channel>-alpine` move together: crates/dedens-repo/tests/repo.rs refuses them apart.",
            "matchPackageNames": ["rust", "docker.io/library/rust"],
            "groupName": "Rust",
        },
        {
            "description": "D180: Verus's releases, `0.<date>.<commit>`, by date.",
            "matchPackageNames": ["verus-lang/verus"],
            "versioning": "loose",
        },
        {
            "description": "D180: vstd moves with the Verus release in the justfile, by hand; its crates.io versions include the rolling releases'.",
            "matchPackageNames": ["vstd"],
            "enabled": false,
        },
    ],
}
