{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    // The shared preset at HEAD of main.
    "extends": ["github>spnngl/.github:renovate.default.json5"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pinned stable Rust in rust-toolchain.toml.",
            "managerFilePatterns": ["/(^|/)rust-toolchain\\.toml$/"],
            "matchStrings": ["channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "rust-lang/rust",
        },
        {
            "customType": "regex",
            "description": "Versions in the justfile, annotated with a `# renovate:` comment on the line above.",
            "managerFilePatterns": ["/(^|/)justfile$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n[a-z_]+ := \"(?<currentValue>[^\"]+)\"",
            ],
            "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}",
        },
    ],
}
